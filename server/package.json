{
  "name": "foundry-ai-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for FoundryAI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:bundle": "tsc --project tsconfig.json && esbuild dist/index.js --bundle --platform=node --target=node18 --outfile=dist/index.bundle.cjs --format=cjs && esbuild dist/backend.js --bundle --platform=node --target=node18 --outfile=dist/backend.bundle.cjs --format=cjs",
    "start": "node dist/index.js",
    "start:bundle": "node dist/index.bundle.cjs",
    "dev": "tsc --project tsconfig.json --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "ws": "^8.14.0",
    "werift": "^0.17.0",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
