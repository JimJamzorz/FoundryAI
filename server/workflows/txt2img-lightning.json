{
	"_template": {
		"description": "Fast text-to-image using an SDXL Lightning checkpoint (~3s). Lightning models are distilled for very few steps at low CFG — quality_steps overrides the default step mapping and CFG is baked at 1.5. General-purpose (no battlemap trigger baked in): for draft maps include 'top-down 2d battlemap, overhead view' in the prompt. Uses the checkpoint's own VAE, core nodes only.",
		"negative_default": "text, watermark, logo, caption, blurry, artifacts, low quality, worst quality",
		"quality_steps": { "low": 4, "medium": 6, "high": 8 },
		"defaults": {
			"model": "dreamshaperXL_lightningDPMSDE.safetensors"
		}
	},
	"1": {
		"_meta": { "title": "MODEL" },
		"class_type": "CheckpointLoaderSimple",
		"inputs": {
			"ckpt_name": "dreamshaperXL_lightningDPMSDE.safetensors"
		}
	},
	"2": {
		"_meta": { "title": "POSITIVE_PROMPT" },
		"class_type": "CLIPTextEncode",
		"inputs": {
			"text": "",
			"clip": ["1", 1]
		}
	},
	"3": {
		"_meta": { "title": "NEGATIVE_PROMPT" },
		"class_type": "CLIPTextEncode",
		"inputs": {
			"text": "",
			"clip": ["1", 1]
		}
	},
	"4": {
		"_meta": { "title": "LATENT" },
		"class_type": "EmptyLatentImage",
		"inputs": {
			"width": 1024,
			"height": 1024,
			"batch_size": 1
		}
	},
	"5": {
		"_meta": { "title": "SAMPLER" },
		"class_type": "KSampler",
		"inputs": {
			"seed": 0,
			"steps": 6,
			"cfg": 1.5,
			"denoise": 1.0,
			"sampler_name": "dpmpp_sde",
			"scheduler": "karras",
			"model": ["1", 0],
			"positive": ["2", 0],
			"negative": ["3", 0],
			"latent_image": ["4", 0]
		}
	},
	"6": {
		"class_type": "VAEDecode",
		"inputs": {
			"samples": ["5", 0],
			"vae": ["1", 2]
		}
	},
	"7": {
		"_meta": { "title": "SAVE" },
		"class_type": "SaveImage",
		"inputs": {
			"filename_prefix": "lightning",
			"images": ["6", 0]
		}
	}
}
