{
	"_template": {
		"description": "Text-to-image battle map using D&D Battlemaps SDXL. Port of the original hardcoded workflow, using the checkpoint's baked-in VAE (no separate sdxl_vae.safetensors needed).",
		"prompt_prefix": "2d DnD battlemap of ",
		"prompt_suffix": ", top-down view, overhead perspective, aerial",
		"negative_default": "grid, low angle, isometric, oblique, horizon, text, watermark, logo, caption, people, creatures, monsters, blurry, artifacts",
		"defaults": {
			"model": "dDBattlemapsSDXL10_upscaleV10.safetensors"
		}
	},
	"1": {
		"_meta": { "title": "MODEL" },
		"class_type": "CheckpointLoaderSimple",
		"inputs": {
			"ckpt_name": "dDBattlemapsSDXL10_upscaleV10.safetensors"
		}
	},
	"2": {
		"_meta": { "title": "POSITIVE_PROMPT" },
		"class_type": "CLIPTextEncode",
		"inputs": {
			"text": "",
			"clip": ["1", 1]
		}
	},
	"3": {
		"_meta": { "title": "NEGATIVE_PROMPT" },
		"class_type": "CLIPTextEncode",
		"inputs": {
			"text": "",
			"clip": ["1", 1]
		}
	},
	"4": {
		"_meta": { "title": "LATENT" },
		"class_type": "EmptyLatentImage",
		"inputs": {
			"width": 1536,
			"height": 1536,
			"batch_size": 1
		}
	},
	"5": {
		"_meta": { "title": "SAMPLER" },
		"class_type": "KSampler",
		"inputs": {
			"seed": 0,
			"steps": 8,
			"cfg": 2.5,
			"denoise": 1.0,
			"sampler_name": "dpmpp_2m_sde",
			"scheduler": "karras",
			"model": ["1", 0],
			"positive": ["2", 0],
			"negative": ["3", 0],
			"latent_image": ["4", 0]
		}
	},
	"6": {
		"class_type": "VAEDecode",
		"inputs": {
			"samples": ["5", 0],
			"vae": ["1", 2]
		}
	},
	"7": {
		"_meta": { "title": "SAVE" },
		"class_type": "SaveImage",
		"inputs": {
			"filename_prefix": "battlemap",
			"images": ["6", 0]
		}
	}
}
