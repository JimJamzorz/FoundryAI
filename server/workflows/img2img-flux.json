{
	"_template": {
		"description": "Flux image-to-image restyle/variation. Reference image is encoded through the Flux VAE and re-denoised; output dimensions match the reference image (the size argument only tunes ModelSamplingFlux). Flux has no negative prompt — describe what you want. denoise: 0.3 subtle, 0.55 balanced, 0.75 loose. Requires the same Flux model/VAE/CLIP files as txt2img-flux.",
		"quality_steps": { "low": 12, "medium": 20, "high": 30 },
		"defaults": {
			"model": "fuxCapacityNSFWPorn_80BF16FP8.safetensors"
		}
	},
	"584": {
		"_meta": { "title": "MODEL" },
		"class_type": "UNETLoader",
		"inputs": {
			"unet_name": "fuxCapacityNSFWPorn_80BF16FP8.safetensors",
			"weight_dtype": "default"
		}
	},
	"583": {
		"class_type": "DualCLIPLoader",
		"inputs": {
			"clip_name1": "clip_l.safetensors",
			"clip_name2": "t5xxl_fp16.safetensors",
			"type": "flux",
			"device": "default"
		}
	},
	"580": {
		"_meta": { "title": "POSITIVE_PROMPT" },
		"class_type": "CLIPTextEncode",
		"inputs": {
			"text": "",
			"clip": ["583", 0]
		}
	},
	"573": {
		"_meta": { "title": "GUIDANCE" },
		"class_type": "FluxGuidance",
		"inputs": {
			"guidance": 4,
			"conditioning": ["580", 0]
		}
	},
	"572": {
		"_meta": { "title": "MODEL_SAMPLING" },
		"class_type": "ModelSamplingFlux",
		"inputs": {
			"max_shift": 1.21,
			"base_shift": 0.5,
			"width": 1024,
			"height": 1024,
			"model": ["584", 0]
		}
	},
	"574": {
		"class_type": "BasicGuider",
		"inputs": {
			"model": ["572", 0],
			"conditioning": ["573", 0]
		}
	},
	"571": {
		"_meta": { "title": "NOISE" },
		"class_type": "RandomNoise",
		"inputs": {
			"noise_seed": 0
		}
	},
	"575": {
		"class_type": "KSamplerSelect",
		"inputs": {
			"sampler_name": "dpmpp_2m_sde_gpu"
		}
	},
	"576": {
		"_meta": { "title": "SCHEDULER" },
		"class_type": "BasicScheduler",
		"inputs": {
			"scheduler": "beta",
			"steps": 20,
			"denoise": 0.55,
			"model": ["572", 0]
		}
	},
	"579": {
		"_meta": { "title": "VAE" },
		"class_type": "VAELoader",
		"inputs": {
			"vae_name": "flux_vae.safetensors"
		}
	},
	"590": {
		"_meta": { "title": "REFERENCE_IMAGE" },
		"class_type": "LoadImage",
		"inputs": {
			"image": "reference.png"
		}
	},
	"591": {
		"class_type": "VAEEncode",
		"inputs": {
			"pixels": ["590", 0],
			"vae": ["579", 0]
		}
	},
	"577": {
		"class_type": "SamplerCustomAdvanced",
		"inputs": {
			"noise": ["571", 0],
			"guider": ["574", 0],
			"sampler": ["575", 0],
			"sigmas": ["576", 0],
			"latent_image": ["591", 0]
		}
	},
	"578": {
		"class_type": "VAEDecode",
		"inputs": {
			"samples": ["577", 0],
			"vae": ["579", 0]
		}
	},
	"558": {
		"_meta": { "title": "SAVE" },
		"class_type": "SaveImage",
		"inputs": {
			"filename_prefix": "flux-restyle",
			"images": ["578", 0]
		}
	}
}
